# Supabase (login + cloud sync). Both values are publishable by design;
# data is protected by Row Level Security. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LLM provider for smart completion (server-side only, never expose to the client)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
